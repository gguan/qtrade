msgid "`Broker.process_bar(ts)` fires:"
msgstr "`Broker.process_bar(ts)` 触发："

#: ../guide/concepts.md:129 ddbeb6485b0b4ac68c03335a65a5cc61
msgid "Drop cancelled / rejected orders from the pending queue."
msgstr "从 pending 队列中清除已取消 / 已拒绝的订单。"

#: ../guide/concepts.md:130 4a9f2e8c4fb04c44af290d9ed3c402f8
msgid "Process executing orders (queued for fill at the next bar's open)."
msgstr "处理 executing 队列订单（排队等下一根 bar 开盘成交）。"

