msgstr "`best_params`"

#: ../guide/walk_forward.md c52b7fd0f3f2409d9dd70884ff62a7a4
msgid "The parameter combo that maximized `maximize` on the train slice."
msgstr "在训练片段上最大化 `maximize` 的参数组合。"

#: ../guide/walk_forward.md 2b75e39adc6140268e01710dd098a003
msgid "`train_stats`"
msgstr "`train_stats`"

#: ../guide/walk_forward.md 00e5ea396dda4518b6f9010ee2f20b01
