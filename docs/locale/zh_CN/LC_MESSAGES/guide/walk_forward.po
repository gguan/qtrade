msgid "Key"
msgstr "键"

#: ../guide/walk_forward.md 1333b39ce78242c1a64412407b99d607
msgid "Value"
msgstr "值"

#: ../guide/walk_forward.md f8a55069ed7e462dac9d66c2f228bc78
msgid "`train_start`, `train_end`"
msgstr "`train_start`, `train_end`"

#: ../guide/walk_forward.md 40a245f1dcab44aa93de8a993d4192c9
msgid "Timestamps of the train slice."
msgstr "训练片段的时间戳。"

#: ../guide/walk_forward.md 0bb82164040b4cf09b4de06c9d5dea90
msgid "`test_start`, `test_end`"
msgstr "`test_start`, `test_end`"

#: ../guide/walk_forward.md 4e132b7f29b34c0d8fa98e95e5f0d486
msgid "Timestamps of the test slice."
msgstr "测试片段的时间戳。"

#: ../guide/walk_forward.md 4207ce68c5fe401c9c4c0d721e0a9491
