#: ../guide/walk_forward.md 711c526dea604561a9720a24997f58a2
msgid "`test_equity`"
msgstr "`test_equity`"

#: ../guide/walk_forward.md a27a71563b5646abbbb1230c43a9a449
msgid "The test slice's `equity_history` Series."
msgstr "测试片段的 `equity_history` Series。"

#: ../guide/walk_forward.md:80 e866de20aa644236ba2ec00d9917fcbf
msgid "The summary:"
msgstr "summary 包含："

#: ../guide/walk_forward.md 590bfc0976ad45a8a8df4d75758c2e6c
